# ====================================================================
# MediKiosk - Environment Configuration
# ====================================================================

# GEMINI_API_KEY: (Optional but recommended)
# Used for real Gemini AI clinical history synthesis, prescription OCR, 
# and dynamic multilingual intake. Get a free API key at:
# https://aistudio.google.com/app/apikey
# If omitted or left empty, the application runs using built-in rule-based
# clinical reasoning fallback algorithms.
GEMINI_API_KEY=""

# APP_URL: The base URL where this app is hosted.
# For local development: http://localhost:3000
# For cloud deployment: automatically configured
APP_URL="http://localhost:3000"

